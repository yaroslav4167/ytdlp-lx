TELEGRAM_BOT_TOKEN=123456789:replace_me

# Optional. Leave empty to use the direct connection.
DOWNLOAD_PROXY=socks5://127.0.0.1:40000

# Optional Spotify Web API credentials.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Interactive HTML cards (private chats). /plain and /bubbles override per user.
BUBBLES_ENABLED=1
# Template directory name under bubbles/designs/.
BUBBLES_DESIGN=default

# Optional path to Deno >=2.3; .tools/deno or Deno on PATH is auto-detected.
YTDLP_DENO=

# Concurrent download/conversion/upload jobs. Remaining jobs wait in FIFO order.
MAX_PARALLEL_DOWNLOADS=2
